//Agenda permissie in het engels toevoegen:
Add-MailboxFolderPermission -Identity "user@domein.nl:\Calendar" -User "beheerder@domein.nl" -AccessRights Editor/reviewer

//Agenda permissie in het Nederlands toevoegen:
Add-MailboxFolderPermission -Identity "user@domein.nl:\Agenda" -User "beheerder@domein.nl" -AccessRights Editor/reviewer

//Agenda permissie in het engels verwijderen:
Remove-MailboxFolderPermission -Identity "user@domein.nl:\Calendar" -User "beheerder@domein.nl"

//Agenda permissie in het Nederlands verwijderen:
Remove-MailboxFolderPermission -Identity "user@domein.nl:\Agenda" -User "beheerder@domein.nl"
